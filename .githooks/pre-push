#!/usr/bin/env bash
# Runs before every push. Unit tests — the last gate inside the agent's own loop.
#
# Deliberately not end-to-end: those belong in CI, where they can be slow. This
# hook has to stay fast enough that nobody reaches for --no-verify.
set -euo pipefail

fail() { printf '\n\033[31m✗ %s\033[0m\n' "$1"; exit 1; }

command -v pnpm >/dev/null || fail "pnpm not found. Run: corepack enable"

echo "→ unit tests"
# `pnpm test` is `vitest --run`. Passing `--run` here as well gives
# `vitest --run --run`, which vitest rejects outright — so the hook failed
# every push rather than every failing push. One command, one spelling.
pnpm test || fail "Tests failed. Fix the code, not the test."

printf '\033[32m✓ pre-push\033[0m\n'
